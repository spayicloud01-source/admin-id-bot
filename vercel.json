{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/lakroi-dashboard/:path*",
      "destination": "https://project-3l39u.vercel.app/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/web/password-login",
      "destination": "/api/web/send?adminAuth=password"
    },
    {
      "source": "/api/web/users",
      "destination": "/api/web/send?adminAuth=users"
    },
    {
      "source": "/api/web/staff",
      "destination": "/api/web/send?adminAuth=staff"
    },
    {
      "source": "/api/customer/session",
      "destination": "/api/web/send?customerRoute=session"
    },
    {
      "source": "/api/customer/payment",
      "destination": "/api/web/send?customerRoute=payment"
    },
    {
      "source": "/api/customer/qr",
      "destination": "/api/web/send?customerRoute=qr"
    },
    {
      "source": "/api/customer/contact",
      "destination": "/api/web/send?customerRoute=contact"
    },
    {
      "source": "/api/customer/discount",
      "destination": "/api/web/send?customerRoute=discount"
    },
    {
      "source": "/customer",
      "destination": "/customer.html"
    }
  ]
}
